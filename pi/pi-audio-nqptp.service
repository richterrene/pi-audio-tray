[Unit]
Description=Pi Audio AirPlay 2 network timing
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/lib/pi-audio-tray/airplay2/shairport-5.6.2-nqptp-1.2.9/nqptp
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
LimitRTPRIO=6
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

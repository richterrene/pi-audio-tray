[Unit]
Description=Update Spotify Soloist from Spotify's official download
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pi-audio-tray/soloist-update
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RuntimeDirectory=pi-audio-tray-update
RuntimeDirectoryMode=0700
CacheDirectory=pi-audio-tray
CacheDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/usr/local/bin
NoExecPaths=/usr/local/bin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
TasksMax=32
